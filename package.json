{
  "name": "airlock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sandboxed MCP runtime \u2014 run any MCP server inside a Solari sandbox",
  "scripts": {
    "probe": "tsx scripts/probe.ts",
    "probe:egress": "tsx scripts/probe-egress.ts",
    "probe:netfilter": "tsx scripts/probe-netfilter.ts",
    "probe:netns": "tsx scripts/probe-netns.ts",
    "relay:e2e": "tsx scripts/relay-e2e.ts",
    "airlock": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "e2e": "tsx scripts/e2e-airlock.ts",
    "probe:warmstart": "tsx scripts/probe-warmstart.ts",
    "probe:warmstart2": "tsx scripts/probe-warmstart2.ts",
    "probe:template": "tsx scripts/probe-template.ts",
    "test:toml": "tsx scripts/test-toml-edit.ts",
    "probe:reliability": "tsx scripts/probe-template-reliability.ts",
    "demo": "tsx demo/run-demo.ts",
    "test:utf8": "tsx scripts/test-utf8.ts",
    "test:drift": "tsx scripts/test-drift.ts",
    "test:broker": "tsx scripts/test-broker.ts",
    "test:inject": "tsx scripts/test-inject-scan.ts",
    "probe:nodeproxy": "tsx scripts/probe-nodeproxy.ts",
    "test:nodefetch": "tsx scripts/test-nodefetch.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@solarisdk/sdk": "^0.1.2",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "bin": {
    "airlock": "./dist/cli.js"
  }
}
